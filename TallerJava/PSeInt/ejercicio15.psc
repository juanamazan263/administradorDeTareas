Algoritmo ejercicio15
	Definir valorUnitario, cant, valorTotal Como Entero
	Escribir 'Indique el valor unitario del articulo'
	Leer valorUnitario
	Escribir 'Indique la cantidad de articulos'
	Leer cant
	valorTotal <- valorUnitario*cant
	Escribir 'El valor total a pagar es de: $', valorTotal
FinAlgoritmo
